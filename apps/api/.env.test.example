# Copy to `.env.test` (gitignored) before running database-backed tests.
#
#   cp apps/api/.env.test.example apps/api/.env.test
#
# WITHOUT THIS FILE THE DATABASE TESTS DO NOT RUN. They skip or fail with a
# confusing connection error, and a green `bun test` does not mean they passed.
#
# Why: `src/test-env-loader.ts` deliberately DELETES any ambient `DATABASE_URL`
# that did not come from this file, so a stray `DATABASE_URL=... bun test` in
# your shell can never point the suite at a real database. It then falls back to
# port 5432, while local Postgres for this project runs on 5434 (container
# `atlasmed-local`). The loader also refuses any database whose name lacks
# "test".
#
# The target database must have the full migration chain applied:
#
#   createdb -h localhost -p 5434 -U postgres atlasmed_test
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5434/atlasmed_test" \
#     bun run --cwd packages/database db:migrate
#
# PostGIS and dblink are required:
#
#   psql "$DATABASE_URL" -c 'CREATE EXTENSION IF NOT EXISTS postgis;' \
#                        -c 'CREATE EXTENSION IF NOT EXISTS dblink;'

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/atlasmed_test

# Optional — every other value has a safe default in `TEST_ENV_DEFAULTS`.
# REDIS_URL=redis://localhost:6379/1
