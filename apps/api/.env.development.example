# ============================================================================
# apps/api — Development environment
# Copy to .env: cp .env.development.example .env
#
# Prerequisites: bun run dev:up (starts Redis, MinIO, Meilisearch, ClickHouse)
# PostgreSQL runs locally — update DATABASE_URL to match your local setup.
# ============================================================================

# Application
NODE_ENV=development
PORT=3000

# ---------------------------------------------------------------------------
# Database — local PostgreSQL (not containerised)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlasmed
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ---------------------------------------------------------------------------
# Redis — started by: bun run dev:up
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=atlasmed:

# ---------------------------------------------------------------------------
# Auth secrets
# Generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-secret-change-in-production-must-be-32-chars
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=atlasmed-api
JWT_AUDIENCE=atlasmed

# Optional: HMAC pepper for token hashing at rest (required in production)
# TOKEN_HASH_PEPPER=

# ---------------------------------------------------------------------------
# CORS / Frontend
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# ---------------------------------------------------------------------------
# Object Storage — MinIO started by: bun run dev:up
# Console: http://localhost:9001  user: minioadmin  pass: minioadmin
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=atlasmed-dev
STORAGE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Search — Meilisearch started by: bun run dev:up
# UI: http://localhost:7700
# ---------------------------------------------------------------------------
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# ---------------------------------------------------------------------------
# Observability — OTEL Collector + SigNoz started by: bun run observability:up
# SigNoz UI: http://localhost:3301
# Uncomment to enable trace/log export in development.
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=atlasmed-api
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Temporal — started by: bun run temporal:up
# UI: http://localhost:8080
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cnes-ingestion

# ---------------------------------------------------------------------------
# External services — leave empty to disable in dev
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_placeholder_replace_in_production
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_WHATSAPP_NUMBER=
# MAPBOX_SECRET_TOKEN=
# MAPBOX_PUBLIC_TOKEN=

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ENABLE_SWAGGER=true
ENABLE_METRICS=true
ENABLE_AUDIT_LOG=true
TWO_FACTOR_ENABLED=false
REGISTRY_SOURCE=mock
