# ============================================================================
# apps/web — Development environment
# Copy to .env.local: cp .env.development.local.example .env.local
# NEVER commit .env.local to git.
# ============================================================================

# API base URL (apps/api must be running on port 3000)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_HEALTH_URL=http://localhost:3000
NEXT_PUBLIC_API_TIMEOUT=10000

# Environment label
NEXT_PUBLIC_APP_ENV=development

# Mapbox (optional in dev — map features will be disabled if not set)
# NEXT_PUBLIC_MAPBOX_TOKEN=
