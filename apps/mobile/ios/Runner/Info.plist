<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>AtlasMed</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>AtlasMed</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>O AtlasMed usa sua localização uma vez para mostrar clínicas próximas no seu território.</string>
	<!-- Exigida pela App Store (erro 90683): o geolocator referencia as APIs de
	     autorização "always". O app só solicita permissão em uso e não declara
	     UIBackgroundModes de localização. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>O AtlasMed usa sua localização para mostrar clínicas próximas e registrar visitas no seu território.</string>
	<key>NSCameraUsageDescription</key>
	<string>O AtlasMed usa a câmera para fotografar documentos do cadastro do estabelecimento.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>O AtlasMed precisa acessar suas fotos para atualizar sua foto de perfil e enviar documentos do cadastro.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allows plain http:// to localhost / unqualified hosts so the app
		     can hit a local backend during development (config.development.json
		     points API_BASE_URL at http://localhost:3000/). Does not relax ATS
		     for any other host — production (https://api.tdomains.uk) is
		     unaffected. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Required for canLaunchUrl / deep links to Waze and Google Maps. -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>waze</string>
		<string>comgooglemaps</string>
		<string>google.navigation</string>
		<string>https</string>
		<string>http</string>
	</array>
	<!--
	  Export compliance. Without this key App Store Connect asks the encryption
	  question on every upload and holds the build in "Missing Compliance" until
	  someone answers it by hand — which defeats an automated TestFlight upload.

	  Declared false because the app uses only HTTPS/TLS provided by the
	  platform, plus `crypto` (Dart) for hashing — SHA/HMAC, not encryption.
	  There is no AES, cipher, or custom cryptography anywhere in lib/. That is
	  the standard exemption.

	  If the app ever ships its own encryption, proprietary or otherwise, this
	  has to be revisited: it is a declaration to Apple, not a build setting.
	-->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
