{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "atlasmed-app",
          "appId": "PENDENTE: substitua pelo ID do app Android",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "atlasmed-app",
          "appId": "PENDENTE: substitua pelo ID do app iOS",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "atlasmed-app",
          "appId": "PENDENTE: substitua pelo ID do app macOS",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "atlasmed-app",
          "configurations": {
            "android": "PENDENTE: substitua pelo ID do app Android",
            "ios": "PENDENTE: substitua pelo ID do app iOS"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "frameworksBackend": {
      "region": "us-central1"
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
