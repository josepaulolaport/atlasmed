# Local development environment for the CNES ingestion worker.
# Copy to apps/workers/cnes-ingestion/.env

NODE_ENV=development

# Temporal (started via bun run temporal:up)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cnes-ingestion

# Database (local PostgreSQL — same as API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlasmed

# CNES archive staging — MinIO (started via bun run dev:up)
CNES_ARCHIVE_BACKEND=minio
CNES_ARCHIVE_S3_BUCKET=cnes-raw
CNES_ARCHIVE_S3_REGION=us-east-1
CNES_ARCHIVE_S3_ENDPOINT=http://localhost:9000
CNES_ARCHIVE_S3_ACCESS_KEY_ID=minioadmin
CNES_ARCHIVE_S3_SECRET_ACCESS_KEY=minioadmin

# Dev load settings
CNES_FTP_MODE=mock
CNES_LOAD_MODE=dev
CNES_EXTRACT_DIR=/tmp/cnes-extract
CNES_ARCHIVE_LOCAL_PATH=/tmp/atlasmed-cnes-archive

# Observability (optional — start with bun run observability:up)
OTEL_SERVICE_NAME=atlasmed-cnes-worker
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
