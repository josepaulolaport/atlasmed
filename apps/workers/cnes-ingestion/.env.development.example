# ============================================================================
# apps/workers/cnes-ingestion — Development environment
# Copy to .env: cp .env.development.example .env
#
# Prerequisites: bun run dev:up + bun run temporal:up
# ============================================================================

NODE_ENV=development

# ---------------------------------------------------------------------------
# Database — same as apps/api
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlasmed

# ---------------------------------------------------------------------------
# Temporal — started by: bun run temporal:up
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=cnes-ingestion

# ---------------------------------------------------------------------------
# Object Storage — MinIO started by: bun run dev:up
# CNES raw files are staged here before ingestion.
# ---------------------------------------------------------------------------
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=atlasmed-dev
STORAGE_REGION=us-east-1

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=atlasmed-cnes-worker
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
LOG_LEVEL=debug
