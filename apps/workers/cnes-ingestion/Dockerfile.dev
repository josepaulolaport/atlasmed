FROM oven/bun:1.3

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-pip unzip zip \
  && pip3 install --no-cache-dir pandas sqlalchemy tqdm psycopg2-binary \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# CNES ZIP + extracted CSVs need ~8-10 GB headroom during monthly ingestion.
VOLUME ["/tmp/cnes-extract", "/tmp/atlasmed-cnes-archive"]

COPY . .

WORKDIR /app/apps/workers/cnes-ingestion

CMD ["bun", "run", "start"]
