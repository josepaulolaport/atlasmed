# Local development environment for the Temporal worker.
# Copy to apps/workers/temporal/.env

NODE_ENV=development

# Temporal (started via bun run temporal:up)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=atlasmed-workflows

# Database (local PostgreSQL — same as API)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/atlasmed

# Meilisearch (search-sync workflows)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_API_KEY=masterKey

# Object storage for cadastro file processing (started via bun run infra:up)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_BUCKET=atlasmed-dev
STORAGE_REGION=us-east-1

# Observability (optional — start with bun run observability:up)
# Logs always print to the console even when these are unset.
OTEL_SERVICE_NAME=atlasmed-temporal-worker
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=development
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:4318/v1/logs
