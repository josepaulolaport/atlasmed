#!/usr/bin/env bash
# Enforce protected-branch guard and run pre-push validation.
# Validation uses root scripts: "bun run lint" and "bun run typecheck".

set -euo pipefail

protected="^refs/heads/(main|master)$"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${remote_ref}" =~ ${protected} ]]; then
    if [[ "${local_ref}" =~ ${protected} ]]; then
      echo "✗ Direct push to '${remote_ref}' from '${local_ref}' is blocked."
      echo "  Use a feature branch and open a PR — see AGENTS.md § Branch and merge workflow."
      exit 1
    fi
  fi
done

# 2) Run lint and typecheck before push.
# This uses existing workspace scripts to keep behavior aligned.
if ! bun run lint; then
  echo "✗ Lint validation failed. Resolve issues and push again."
  exit 1
fi

if ! bun run typecheck; then
  echo "✗ Typecheck validation failed. Resolve issues and push again."
  exit 1
fi

# 3) Flutter mobile validation (uses FVM — `.fvmrc` defines the SDK version).
if ! command -v fvm &>/dev/null; then
  echo "• FVM not found."
  exit 1
fi
echo "• Running Flutter checks…"

if ! bun run mobile:format; then
  echo "✗ Dart formatting issues found in apps/mobile/."
  echo "  Fix with: bun run mobile:format"
  exit 1
fi

if ! bun run mobile:lint; then
  echo "✗ Flutter analyze failed. Resolve issues and push again."
  exit 1
fi

echo "✓ Pre-push validation passed."

exit 0
