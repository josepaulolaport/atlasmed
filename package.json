{
  "name": "atlasmed",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "AtlasMed - Sales Application Monorepo",
  "workspaces": [
    "apps/*",
    "apps/workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "env:check": "turbo env:check --filter=@atlasmed/config",
    "api:dev": "turbo dev --filter=@atlasmed/api",
    "api:build": "turbo build --filter=@atlasmed/api",
    "api:lint": "turbo lint --filter=@atlasmed/api",
    "api:test": "turbo test --filter=@atlasmed/api",
    "api:typecheck": "turbo typecheck --filter=@atlasmed/api",
    "mobile:dev": "cd apps/mobile && fvm flutter run",
    "mobile:build": "cd apps/mobile && fvm flutter build",
    "mobile:format": "turbo format --filter=@atlasmed/mobile",
    "mobile:lint": "turbo lint --filter=@atlasmed/mobile",
    "mobile:test": "turbo test --filter=@atlasmed/mobile",
    "workers:dev": "turbo dev --filter=@atlasmed/temporal-worker",
    "workers:test": "turbo test --filter=@atlasmed/temporal-worker",
    "workers:typecheck": "turbo typecheck --filter=@atlasmed/temporal-worker",
    "dev:backend": "bun run api:dev",
    "dev:mobile": "bun run mobile:dev",
    "build:mobile": "bun run mobile:build",
    "format:mobile": "bun run mobile:format",
    "lint:mobile": "bun run mobile:lint",
    "test:mobile": "bun run mobile:test",
    "dev:temporal-worker": "bun run workers:dev",
    "db:migrate": "cd packages/database && bun run db:migrate",
    "infra:up": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "infra:down:volumes": "docker compose -f deploy/docker-compose.dev.yml down -v",
    "infra:logs": "docker compose -f deploy/docker-compose.dev.yml logs -f",
    "infra:ps": "docker compose -f deploy/docker-compose.dev.yml ps",
    "dev:up": "bun run infra:up",
    "dev:down": "bun run infra:down",
    "dev:down:volumes": "bun run infra:down:volumes",
    "dev:logs": "bun run infra:logs",
    "dev:ps": "bun run infra:ps",
    "temporal:up": "docker compose -f deploy/docker-compose.temporal.yml up -d",
    "temporal:down": "docker compose -f deploy/docker-compose.temporal.yml down",
    "observability:up": "bash deploy/scripts/signoz-up.sh",
    "observability:down": "bash deploy/scripts/signoz-down.sh",
    "observability:verify": "bash deploy/scripts/verify-observability.sh",
    "hooks:install": "bun run prepare",
    "prepare": "husky",
    "clean": "rm -rf .turbo"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "husky": "^9.1.7",
    "turbo": "^2.10.5",
    "typescript": "^5"
  },
  "engines": {
    "bun": "1.3.14"
  }
}
