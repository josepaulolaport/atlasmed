{
  "name": "atlasmed",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "AtlasMed - Sales Application Monorepo",
  "workspaces": [
    "apps/*",
    "apps/workers/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:backend": "turbo dev --filter=@atlasmed/api",
    "dev:web": "turbo dev --filter=@atlasmed/web",
    "dev:mobile": "cd apps/mobile && flutter run",
    "build": "turbo build",
    "build:mobile": "cd apps/mobile && flutter build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "hooks:install": "bun run prepare",
    "prepare": "husky",
    "format:mobile": "cd apps/mobile && dart format --set-exit-if-changed .",
    "lint:mobile": "cd apps/mobile && flutter analyze",
    "test": "turbo test",
    "test:mobile": "cd apps/mobile && flutter test",
    "clean": "rm -rf .turbo",
    "dev:up": "docker compose -f deploy/docker-compose.dev.yml up -d",
    "dev:down": "docker compose -f deploy/docker-compose.dev.yml down",
    "dev:down:volumes": "docker compose -f deploy/docker-compose.dev.yml down -v",
    "dev:logs": "docker compose -f deploy/docker-compose.dev.yml logs -f",
    "dev:ps": "docker compose -f deploy/docker-compose.dev.yml ps",
    "temporal:up": "docker compose -f deploy/docker-compose.temporal.yml up -d",
    "temporal:down": "docker compose -f deploy/docker-compose.temporal.yml down",
    "observability:up": "bash deploy/scripts/signoz-up.sh",
    "observability:down": "bash deploy/scripts/signoz-down.sh",
    "observability:verify": "bash deploy/scripts/verify-observability.sh",
    "db:migrate": "cd packages/database && bun run db:migrate",
    "db:seed": "cd apps/api && bun run db:seed",
    "dev:cnes-worker": "turbo dev --filter=@atlasmed/cnes-ingestion-worker"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "husky": "^9.1.7",
    "turbo": "^2.10.5",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  }
}
