UNCLOUD_CONNECT=ssh://root@example
UNCLOUD_SSH_PRIVATE_KEY=change-me

# Remote application Postgres. This database is not deployed in Uncloud.
DATABASE_URL=postgresql://user:password@remote-host:5432/atlasmed
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# API/security
JWT_ACCESS_SECRET=change-me-minimum-32-characters
TOKEN_HASH_PEPPER=change-me-minimum-16-characters
CORS_ORIGINS=
FRONTEND_URL=
RESEND_API_KEY=change-me
RESEND_FROM_EMAIL=AtlasMed <noreply@tdomains.uk>

# Optional communication providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Optional map providers
MAPBOX_SECRET_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# Internal services
TEMPORAL_DB_PASSWORD=change-me
MEILISEARCH_API_KEY=change-me-search-key

# MinIO server credentials. These provision the MinIO container itself and are
# NOT what the API signs requests with — see STORAGE_ACCESS_KEY_ID below.
# They stop being needed once R2 serves production.
MINIO_ROOT_USER=atlasmed
MINIO_ROOT_PASSWORD=change-me-minimum-32-characters

# Object storage (S3-compatible: Cloudflare R2 in production; MinIO before it).
# All five STORAGE_* values below are required in production and validated at
# API and worker boot — a missing one refuses to start rather than signing
# requests that are aimed wrong or unreachable. No fallbacks anywhere.
STORAGE_BUCKET=atlasmed-production
# MinIO ignores the region; R2 accepts ONLY "auto". Correct for both.
STORAGE_REGION=auto
# Server-side endpoint (API/worker → object store).
#   R2 (current):  https://<account-id>.r2.cloudflarestorage.com
#   MinIO (was):   http://atlasmed-minio:9000
# Account host ONLY — no bucket path. forcePathStyle appends the bucket itself,
# so including it doubles the path. The R2 dashboard's "S3 API" field shows the
# bucket URL, not this.
STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Baked into presigned URLs handed to phones and browsers, so it must be https://
# and reachable from outside the cluster. Never derived from STORAGE_ENDPOINT —
# that fallback shipped an unreachable internal hostname to devices once already.
# Same value as above on R2; on MinIO+Caddy it was storage.tdomains.uk, which is
# why both variables still exist.
STORAGE_PUBLIC_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Credentials the API and workers sign with — the R2 API token id/secret.
# MINIO_ROOT_* above provision the MinIO server itself and are a different thing.
# An Object Read & Write token is enough: the bucket must already exist, and boot
# treats AccessDenied on the existence probe as "scoped credential" and continues.
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me

TEMPORAL_TASK_QUEUE=atlasmed-workflows
