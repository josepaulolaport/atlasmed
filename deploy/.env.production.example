UNCLOUD_CONNECT=ssh://root@example
UNCLOUD_SSH_PRIVATE_KEY=change-me

# Remote application Postgres. This database is not deployed in Uncloud.
DATABASE_URL=postgresql://user:password@remote-host:5432/atlasmed
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# API/security
JWT_ACCESS_SECRET=change-me-minimum-32-characters
TOKEN_HASH_PEPPER=change-me-minimum-16-characters
# Exact origins. Firebase Hosting app/previews are also allowed in code:
# https://atlasmed-app.web.app and https://atlasmed-app--*.web.app
CORS_ORIGINS=https://atlasmed-web.b1ixob.uncld.dev
FRONTEND_URL=https://atlasmed-web.b1ixob.uncld.dev
RESEND_API_KEY=change-me
RESEND_FROM_EMAIL=AtlasMed <noreply@tdomains.uk>

# Optional communication providers
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Optional map providers
MAPBOX_SECRET_TOKEN=
MAPBOX_PUBLIC_TOKEN=

# Internal services
TEMPORAL_DB_PASSWORD=change-me
MEILISEARCH_API_KEY=change-me-search-key

# MinIO server credentials. These provision the MinIO container itself and are
# NOT what the API signs requests with — see STORAGE_ACCESS_KEY_ID below.
# They stop being needed once R2 serves production.
MINIO_ROOT_USER=atlasmed
MINIO_ROOT_PASSWORD=change-me-minimum-32-characters

# Object storage (S3-compatible: MinIO today, Cloudflare R2 at cutover).
# All five STORAGE_* values below are required in production and validated at
# API and worker boot — a missing one refuses to start rather than signing
# requests that are aimed wrong or unreachable. No fallbacks anywhere.
STORAGE_BUCKET=atlasmed-production
# MinIO ignores the region. R2 accepts ONLY "auto" — set it in the same change
# that flips the endpoints below, or the API will refuse to boot.
STORAGE_REGION=us-east-1
# Server-side endpoint (API/worker → object store), cluster-internal.
#   MinIO: http://atlasmed-minio:9000
#   R2:    https://<account-id>.r2.cloudflarestorage.com
STORAGE_ENDPOINT=http://atlasmed-minio:9000
# Baked into presigned URLs handed to phones and browsers, so it must be
# https:// and resolvable from outside the cluster. Never derived from
# STORAGE_ENDPOINT. Caddy terminates TLS for storage.tdomains.uk → MinIO :9000;
# on R2 this is the public bucket/custom domain.
STORAGE_PUBLIC_ENDPOINT=https://storage.tdomains.uk
# Credentials the API and workers sign with. On MinIO these may match
# MINIO_ROOT_* today; at cutover they become the R2 API token id/secret.
STORAGE_ACCESS_KEY_ID=change-me
STORAGE_SECRET_ACCESS_KEY=change-me

TEMPORAL_TASK_QUEUE=atlasmed-workflows
