{
  "$schema": "https://turbo.build/schema.json",

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },

    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },

    "lint": {
      "dependsOn": ["^lint"],
      "outputs": []
    },

    "format": {
      "outputs": []
    },

    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },

    "env:check": {
      "cache": false,
      "outputs": []
    },

    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
